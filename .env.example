# Copy this file to ".env" and fill in your own values.
# Never commit your real ".env" file to GitHub.

# ---- AI brain ----
# Default: "local" — runs entirely on your PC via a downloaded model file,
# no API key, no cloud calls, works offline. One-time setup:
#   python download_model.py
# (no Hugging Face account or token needed — it's a public file download)
AI_PROVIDER=local

# Alternative: AI_PROVIDER=huggingface uses Hugging Face's free API instead
# of a local download — needs a token from https://huggingface.co/settings/tokens
# with "Make calls to Inference Providers" enabled. Less reliable in practice
# than running locally (depends on their servers being up and reachable).
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct

# Alternative: AI_PROVIDER=gemini / anthropic (also need their own free keys).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Email module (optional) ----
# Gmail: create an "App Password" at https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ---- WhatsApp module (optional) ----
MY_WHATSAPP_NUMBER=

# ---- Misc ----
USER_NAME=Farhan
CITY_FOR_WEATHER=Islamabad
